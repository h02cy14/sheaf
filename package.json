{
  "name": "sheaf-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @sheaf/app dev",
    "tauri": "pnpm --filter @sheaf/app tauri",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "node scripts/check-deps.mjs",
    "check:chars": "node scripts/check-source-chars.mjs --check apps/sheaf/src packages/core/src scripts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm check:deps && pnpm check:chars"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
